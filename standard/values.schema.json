{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["image"],
  "properties": {
    "image": {
      "type": "string",
      "minLength": 1,
      "description": "Container image",
      "examples": ["docker.io/searxng/searxng:2026.10.27-abc1234"]
    },
    "imagePullPolicy": {"type": "string", "enum": ["Always", "Never", "IfNotPresent"]},
    "replicas": {"type": "integer", "minimum": 0},
    "strategy": {"type": "string", "enum": ["Recreate", "RollingUpdate"]},
    "command": {"type": "array", "items": {"type": "string"}},
    "args": {"type": "array", "items": {"type": "string"}},
    "port": {
      "type": ["integer", "string"],
      "description": "Main container port, named http"
    },
    "extraPorts": {
      "type": "object",
      "description": "name: containerPort",
      "additionalProperties": {"type": "integer"}
    },
    "env": {
      "type": "object",
      "description": "NAME: value",
      "additionalProperties": {"type": ["string", "number", "boolean"]}
    },
    "extraEnv": {"type": "array", "items": {"type": "object"}},
    "envFrom": {"type": "array", "items": {"type": "object"}},
    "files": {
      "type": "object",
      "description": "Absolute path: file content",
      "propertyNames": {"pattern": "^/"},
      "additionalProperties": {"type": "string"}
    },
    "persistence": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["mountPath"],
        "properties": {
          "mountPath": {"type": "string", "pattern": "^/"},
          "size": {"type": "string"},
          "storageClass": {"type": "string"},
          "accessMode": {
            "type": "string",
            "enum": ["ReadWriteOnce", "ReadWriteOncePod", "ReadWriteMany", "ReadOnlyMany"]
          },
          "existingClaim": {"type": "string"},
          "keep": {"type": "boolean"}
        },
        "additionalProperties": false
      }
    },
    "healthCheck": {"type": "string", "description": "HTTP GET path for liveness and readiness"},
    "livenessProbe": {"type": "object"},
    "readinessProbe": {"type": "object"},
    "startupProbe": {"type": "object"},
    "service": {
      "type": "object",
      "properties": {
        "type": {"type": "string", "enum": ["ClusterIP", "NodePort", "LoadBalancer"]},
        "port": {"type": ["integer", "string"]},
        "appProtocol": {"type": "string"},
        "annotations": {"type": "object"}
      }
    },
    "expose": {
      "type": "object",
      "properties": {
        "hostname": {"type": "string"},
        "type": {"type": "string", "enum": ["", "ingress", "httproute", "route"]},
        "path": {"type": "string", "pattern": "^/"},
        "annotations": {"type": "object"},
        "className": {"type": "string"},
        "tls": {"type": "boolean"},
        "tlsSecretName": {"type": "string"},
        "parentRefs": {"type": "array", "items": {"type": "object"}}
      }
    },
    "openshift": {
      "type": "object",
      "properties": {
        "imageStream": {"type": "boolean"},
        "scc": {"type": "string"}
      }
    },
    "serviceAccount": {
      "type": "object",
      "properties": {
        "create": {"type": "boolean"},
        "automount": {"type": "boolean"},
        "annotations": {"type": "object"},
        "name": {"type": "string"}
      }
    },
    "podAnnotations": {"type": "object"},
    "podLabels": {"type": "object"},
    "podSecurityContext": {"type": "object"},
    "securityContext": {"type": "object"},
    "resources": {"type": "object"},
    "extraVolumes": {"type": "array"},
    "extraVolumeMounts": {"type": "array"},
    "nodeSelector": {"type": "object"},
    "tolerations": {"type": "array"},
    "affinity": {"type": "object"}
  }
}
